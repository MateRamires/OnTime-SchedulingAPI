@OnTimeScheduling.Api_HostAddress = http://localhost:5207
@AccessToken = paste-access-token-here
@AppointmentId = 00000000-0000-0000-0000-000000000000

POST {{OnTimeScheduling.Api_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "change-me"
}

###

GET {{OnTimeScheduling.Api_HostAddress}}/api/Auth/me
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

PATCH {{OnTimeScheduling.Api_HostAddress}}/api/Appointments/{{AppointmentId}}/cancel
Authorization: Bearer {{AccessToken}}
